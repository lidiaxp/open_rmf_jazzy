<?xml version="1.0" ?>
<sdf version="1.10">
  <model name="turtlebot4_slotcar">
    <pose>0 0 0.01 0 0 0</pose>
    <static>false</static>
    <allow_auto_disable>true</allow_auto_disable>

    <!-- Base -->
    <link name="base_link">
      <pose>0 0 0.05 0 0 0</pose>
      <inertial>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.012</ixx>
          <iyy>0.012</iyy>
          <izz>0.015</izz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry>
          <cylinder>
            <radius>0.17</radius>
            <length>0.09</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="base_visual">
        <geometry>
          <cylinder>
            <radius>0.17</radius>
            <length>0.09</length>
          </cylinder>
        </geometry>
      </visual>
    </link>

    <!-- Wheels -->
    <link name="left_wheel_link">
      <pose>0 0.115 0.033 0 1.57079632679 0</pose>
      <inertial><mass>0.25</mass><inertia><ixx>0.0006</ixx><iyy>0.0006</iyy><izz>0.0006</izz></inertia></inertial>
      <collision name="left_wheel_collision">
        <geometry><cylinder><radius>0.033</radius><length>0.019</length></cylinder></geometry>
      </collision>
      <visual name="left_wheel_visual">
        <geometry><cylinder><radius>0.033</radius><length>0.019</length></cylinder></geometry>
      </visual>
    </link>
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel_link</child>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>

    <link name="right_wheel_link">
      <pose>0 -0.115 0.033 0 1.57079632679 0</pose>
      <inertial><mass>0.25</mass><inertia><ixx>0.0006</ixx><iyy>0.0006</iyy><izz>0.0006</izz></inertia></inertial>
      <collision name="right_wheel_collision">
        <geometry><cylinder><radius>0.033</radius><length>0.019</length></cylinder></geometry>
      </collision>
      <visual name="right_wheel_visual">
        <geometry><cylinder><radius>0.033</radius><length>0.019</length></cylinder></geometry>
      </visual>
    </link>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel_link</child>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>

    <!-- Caster -->
    <link name="caster_link">
      <pose>0.13 0 -0.005 0 0 0</pose>
      <inertial><mass>0.05</mass><inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz></inertia></inertial>
      <collision name="caster_collision">
        <geometry><sphere><radius>0.015</radius></sphere></geometry>
      </collision>
      <visual name="caster_visual">
        <geometry><sphere><radius>0.015</radius></sphere></geometry>
      </visual>
    </link>
    <joint name="caster_joint" type="ball">
      <parent>base_link</parent>
      <child>caster_link</child>
    </joint>

    <!-- Lidar -->
    <link name="lidar_link">
      <pose>0.0 0.0 0.14 0 0 0</pose>
      <inertial><mass>0.1</mass><inertia><ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz></inertia></inertial>
      <sensor name="scan" type="gpu_lidar">
        <update_rate>20</update_rate>
        <pose>0 0 0 0 0 0</pose>
        <topic>scan</topic>
        <ray>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.05</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
      </sensor>
      <visual name="lidar_visual">
        <geometry><cylinder><radius>0.03</radius><length>0.04</length></cylinder></geometry>
      </visual>
      <collision name="lidar_collision">
        <geometry><cylinder><radius>0.03</radius><length>0.04</length></cylinder></geometry>
      </collision>
    </link>
    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>

    <!-- Frame -->
    <frame name="base_footprint" attached_to="base_link">
      <pose>0 0 0 0 0 0</pose>
    </frame>

    <!-- ============ Slotcar plugin (as requested) ============ -->
    <!-- Note: This plugin typically drives a vehicle kinematically (used with RMF demos).
         It may conflict with other drive plugins like diff_drive. -->
    <plugin name="slotcar" filename="libslotcar.so">
      <nominal_drive_speed>0.5</nominal_drive_speed>
      <nominal_drive_acceleration>0.25</nominal_drive_acceleration>
      <max_drive_acceleration>0.75</max_drive_acceleration>

      <nominal_turn_speed>0.6</nominal_turn_speed>
      <nominal_turn_acceleration>1.5</nominal_turn_acceleration>
      <max_turn_acceleration>2.0</max_turn_acceleration>

      <tire_radius>0.1</tire_radius>
      <base_width>0.3206</base_width>

      <stop_distance>0.75</stop_distance>
      <stop_radius>0.75</stop_radius>

      <reversible>true</reversible>

      <nominal_voltage>12.0</nominal_voltage>
      <nominal_capacity>24.0</nominal_capacity>
      <charging_current>5.0</charging_current>

      <mass>20.0</mass>
      <inertia>10.0</inertia>
      <friction_coefficient>0.22</friction_coefficient>

      <nominal_power>20.0</nominal_power>
    </plugin>

    <!-- Optional: remove/replace with diff_drive if you plan on standard ROS control -->
    <!--
    <plugin name="diff_drive" filename="ignition-gazebo-diff-drive-system">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.23</wheel_separation>
      <wheel_radius>0.033</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <enable_odom_tf>true</enable_odom_tf>
    </plugin>
    -->

  </model>
</sdf>
