<?xml version="1.0" ?>
<sdf version="1.10">
  <model name="turtlebot4_lite">
    <static>false</static>
    <allow_auto_disable>true</allow_auto_disable>

    <!-- =================== Base (Create 3 simplified) =================== -->
    <link name="base_link">
      <pose>0 0 0.045 0 0 0</pose>
      <inertial>
        <mass>3.5</mass>
        <inertia>
          <ixx>0.02</ixx>
          <iyy>0.02</iyy>
          <izz>0.028</izz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry>
          <mesh>
            <uri>file:///home/ros/rmf_ws/custom_maps/tb4_model/meshes/shell_collision.dae</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="base_visual">
        <geometry>
          <mesh>
            <uri>file:///home/ros/rmf_ws/custom_maps/tb4_model/meshes/shell.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <!-- =================== Tower structure =================== -->
    <link name="tower_link">
      <pose>0.0 0.0 0.10 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.002</ixx>
          <iyy>0.002</iyy>
          <izz>0.003</izz>
        </inertia>
      </inertial>
      <visual name="tower_visual">
        <geometry>
          <mesh>
            <uri>file:///home/ros/rmf_ws/custom_maps/tb4_model/meshes/tower.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <visual name="tower_standoff_visual">
        <geometry>
          <mesh>
            <uri>file:///home/ros/rmf_ws/custom_maps/tb4_model/meshes/tower_standoff.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <visual name="tower_sensor_plate_visual">
        <geometry>
          <mesh>
            <uri>file:///home/ros/rmf_ws/custom_maps/tb4_model/meshes/tower_sensor_plate.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <visual name="weight_block_visual">
        <geometry>
          <mesh>
            <uri>file:///home/ros/rmf_ws/custom_maps/tb4_model/meshes/weight_block.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <joint name="tower_joint" type="fixed">
      <parent>base_link</parent>
      <child>tower_link</child>
    </joint>

    <!-- =================== Lidar =================== -->
    <link name="lidar_link">
      <pose>0.0 0.0 0.18 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>1e-4</ixx>
          <iyy>1e-4</iyy>
          <izz>1e-4</izz>
        </inertia>
      </inertial>
      <visual name="rplidar_visual">
        <geometry>
          <mesh>
            <uri>file:///home/ros/rmf_ws/custom_maps/tb4_model/meshes/rplidar.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>20</update_rate>
        <topic>scan</topic>
        <ray>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.05</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
      </sensor>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent>tower_link</parent>
      <child>lidar_link</child>
    </joint>

    <!-- =================== Camera (OAK-D Lite) =================== -->
    <link name="camera_link">
      <pose>0.0 0.0 0.22 0 0 0</pose>
      <inertial>
        <mass>0.12</mass>
        <inertia>
          <ixx>1e-4</ixx>
          <iyy>1e-4</iyy>
          <izz>1e-4</izz>
        </inertia>
      </inertial>
      <visual name="camera_bracket_visual">
        <geometry>
          <mesh>
            <uri>file:///home/ros/rmf_ws/custom_maps/tb4_model/meshes/camera_bracket.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <visual name="oakd_lite_visual">
        <geometry>
          <mesh>
            <uri>file:///home/ros/rmf_ws/custom_maps/tb4_model/meshes/oakd_lite.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent>tower_link</parent>
      <child>camera_link</child>
    </joint>

    <!-- =================== Wheels =================== -->
    <link name="left_wheel_link">
      <pose>0 0.115 0.033 0 1.5708 0</pose>
      <collision name="left_wheel_collision">
        <geometry>
          <cylinder><radius>0.033</radius><length>0.019</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="left_wheel_visual">
        <geometry>
          <cylinder><radius>0.033</radius><length>0.019</length></cylinder>
        </geometry>
      </visual>
    </link>

    <link name="right_wheel_link">
      <pose>0 -0.115 0.033 0 1.5708 0</pose>
      <collision name="right_wheel_collision">
        <geometry>
          <cylinder><radius>0.033</radius><length>0.019</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="right_wheel_visual">
        <geometry>
          <cylinder><radius>0.033</radius><length>0.019</length></cylinder>
        </geometry>
      </visual>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel_link</child>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel_link</child>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>

    <!-- =================== Slotcar plugin =================== -->
    <plugin name="slotcar" filename="libslotcar.so">
      <nominal_drive_speed>0.5</nominal_drive_speed>
      <nominal_drive_acceleration>0.25</nominal_drive_acceleration>
      <max_drive_acceleration>0.75</max_drive_acceleration>

      <nominal_turn_speed>0.6</nominal_turn_speed>
      <nominal_turn_acceleration>1.5</nominal_turn_acceleration>
      <max_turn_acceleration>2.0</max_turn_acceleration>

      <tire_radius>0.033</tire_radius>
      <base_width>0.23</base_width>

      <stop_distance>0.75</stop_distance>
      <stop_radius>0.75</stop_radius>

      <reversible>true</reversible>

      <nominal_voltage>12.0</nominal_voltage>
      <nominal_capacity>24.0</nominal_capacity>
      <charging_current>5.0</charging_current>

      <mass>20.0</mass>
      <inertia>10.0</inertia>
      <friction_coefficient>0.22</friction_coefficient>

      <nominal_power>20.0</nominal_power>
    </plugin>

    <!-- =================== Diff drive plugin =================== -->
    <!-- <plugin name="diff_drive" filename="ignition-gazebo-diff-drive-system">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <wheel_separation>0.23</wheel_separation>
      <wheel_radius>0.033</wheel_radius>

      <topic>cmd_vel</topic>
      <odometry_topic>odom</odometry_topic>

      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <odom_publish_frequency>30</odom_publish_frequency>
      <enable_wheel_slip>false</enable_wheel_slip>
    </plugin>

    <plugin name="gazebo_ros_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.23</wheel_separation>
      <wheel_diameter>0.066</wheel_diameter>
      <publish_odom>true</publish_odom>
      <publish_tf>false</publish_tf>
      <update_rate>100</update_rate>
    </plugin> -->
  </model>
</sdf>
